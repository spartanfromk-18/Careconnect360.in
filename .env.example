# ------------------------------------------------------------------------------
# CareConnect360 Environment Variables
#
# Copy this file to `.env` for local development. On Vercel, set every value in
# Project Settings > Environment Variables (Production, Preview, Development).
#
# The API fails fast (module-load throw) when a required variable is missing so
# a broken deployment never serves traffic with half-configured secrets.
# ------------------------------------------------------------------------------

# --- CORS ---------------------------------------------------------------------
# Exact production origin, no trailing slash, no quotes.
# Example: https://careconnect360.in
# Used by every API route. Requests whose Origin is not exactly this value do NOT
# get an Access-Control-Allow-Origin header and are blocked by browsers.
# Missing: CORS headers are simply not emitted (fail-closed).
ALLOWED_ORIGIN=

# Comma-separated exact origins for staging/preview deployments
# (no wildcard/suffix matching). Also honored by CORS.
# Example: https://careconnect360-abc123.vercel.app,https://careconnect360-dev.vercel.app
ALLOWED_PREVIEW_ORIGINS=

# --- SUPABASE -----------------------------------------------------------------
SUPABASE_URL=

# Service role key. SERVER-SIDE ONLY (submit.js, webhook-razorpay.js, admin-verify.js).
# Bypasses RLS. Never expose in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Anon/publishable key. Used client-side (auth.js) and by bookings.js with the
# caller's session token — RLS enforces data isolation.
SUPABASE_ANON_KEY=

# --- RAZORPAY ---------------------------------------------------------------
# Razorpay key id/secret (server-side only).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Must match the secret configured on the Razorpay webhook, otherwise webhook
# requests are rejected with 400 and payment events are dropped.
RAZORPAY_WEBHOOK_SECRET=

# --- UPSTASH REDIS -----------------------------------------------------------
# Used for rate limiting, order idempotency, payment-replay guards and the
# admin JWT blocklist. If these are missing the handlers throw at load time.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- RESEND (email) ----------------------------------------------------------
RESEND_API_KEY=

# Verified sender domain address (e.g. notifications@careconnect360.in).
# Enforced fail-fast: submit.js, webhook-razorpay.js and lib/email.js throw at
# module load when this is missing. Set in every Vercel environment.
SENDER_EMAIL=

# Admin notification recipient for bookings, callbacks, payment failures/refunds.
ADMIN_EMAIL=

# --- ADMIN AUTH --------------------------------------------------------------
# JWT signing secret, must be >= 32 characters. Generate: openssl rand -base64 48
JWT_SECRET=

# bcrypt hash of the admin password. Generate:
#   node -e "console.log(require('bcryptjs').hashSync('YOUR_PASSWORD', 10))"
# Compared with bcrypt.compare — never a plain-text equality.
ADMIN_PASSWORD_HASH=

# Comma-separated IPv4/IPv6 allowlist for /api/admin-* endpoints. REQUIRED and
# fail-closed: requests from non-listed IPs are dropped with 403. The wildcard
# "*" is REJECTED at runtime (module throws) — explicit IPs only.
# Example: 203.0.113.10,2001:db8::1
ADMIN_ALLOWED_IPS=

# --- SENTRY ------------------------------------------------------------------
# REQUIRED. lib/logger.js throws at module load when this is missing (fail-fast,
# no silent fallback). Do not deploy without it.
SENTRY_DSN=
